{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"competition","sourceId":147734}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"0c0bbac6-cd38-4620-a812-6d37675b2cea","cell_type":"markdown","source":"# Kaggriculture: Autoregressive Structured PPO + League Self-Play\n\nAction space redesigned from 20 flat macros to a type head (11 categories) + a shared argument head (5-way, conditioned on the sampled type via embedding) for the 3 families that need one (sell-level, crop, animal) -- the OpenAI Five / AlphaStar pick-type-then-pick-target pattern, scoped to this game's action surface. 'Target' here means crop/animal/sell-fraction, not a raw tile coordinate -- tile selection stays with the deterministic nearest-tile routing.\n\n**Action interface changed again -- old (flat-macro) checkpoints are NOT compatible; train fresh.**","metadata":{}},{"id":"611913c1-c92d-4107-ba2c-b13d3cfa0c8f","cell_type":"markdown","source":"## Imports & setup","metadata":{}},{"id":"56e79e35-a9c1-4686-921f-9e5a2fb33a5c","cell_type":"code","source":"import copy\nimport os\nimport random\nimport numbers\nimport dataclasses\nfrom typing import Optional, List\n\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport matplotlib.pyplot as plt\n\ntry:\n    import ipywidgets  # noqa: F401 -- presence check only\n    from tqdm.notebook import trange\nexcept ImportError:\n    from tqdm import trange  # falls back to a plain text bar if ipywidgets isn't installed\n\nfrom kaggle_environments import make\n\nCHECKPOINT_DIR = \"./checkpoints\"\nos.makedirs(CHECKPOINT_